# Copia este archivo a .env (NUNCA subas .env a Git) o exporta las variables en tu terminal.
ANTHROPIC_API_KEY=pon_aqui_tu_llave
# Revisa en la documentación oficial vigente el nombre del modelo.
MODEL=claude-sonnet-5-5
UPSTREAM_URL=https://api.anthropic.com/v1/messages
# Token casual que la app manda en la cabecera x-app-token (NO es un secreto real).
APP_TOKEN=cambia-este-token
PORT=8787
